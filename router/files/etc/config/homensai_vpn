config main 'main'
    option enabled '1'
    option interval '10'
    option checkpoint '900'
    option probe_limit '16'
    option live_log_limit '2000'
    option history_days '7'
    option appearance_design 'b'
    # Trust on first use of the VPN servers' keys: warn (default when absent), enforce (Auto refuses a channel whose
    # server key changed until homensai-vpn-server-key accept), off.
    # option server_key_pin 'warn'

