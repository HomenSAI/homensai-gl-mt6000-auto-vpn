{
  "about": "Shared cases of forward_resume.decide (Lua: tests/lua/test_forward_resume.lua, Python: tests/test_forward_resume.py). Each case: set (journal keys), unset (journal keys), facts (overrides), expect (refusal code or null = finish the switch).",
  "journal": {
    "tx": "abababababababababababababababab", "phase": "APPLYING", "proof_scope": "router-probed-ipv4",
    "pair_transition": {"destination_role": "target", "before_policy_role": "source"},
    "trial": false, "transition_source": "automatic", "before": ["r1", "r2"], "after": ["r2", "r1"],
    "started": 1000.0, "deadline": 1120.0, "monotonic_deadline": 620.0, "pid": null,
    "rtp_dispatched": true, "forward_policy_touched": true, "kernel_before_verified": true
  },
  "facts": {"same_boot": true, "wall": 1020.0, "mono": 520.0, "wanted": true, "stop_requested": null, "stopping": false,
            "source_health": false, "reserve_health": true},
  "cases": [
    {"name": "killed in APPLYING: finish", "expect": null},
    {"name": "killed in WAIT-CLIENT: finish", "set": {"phase": "WAIT-CLIENT", "expected_exit": "203.0.113.5"}, "expect": null},
    {"name": "no dispatch yet: finish (redo from the untouched graph)", "set": {"rtp_dispatched": false, "forward_policy_touched": false}, "expect": null},
    {"name": "rollback_failures 0 is no failure", "set": {"rollback_failures": 0}, "expect": null},
    {"name": "an old Stop before this switch", "facts": {"stop_requested": 900.0}, "expect": null},
    {"name": "ARMED rolls back", "set": {"phase": "ARMED"}, "expect": "PHASE"},
    {"name": "RESTORING rolls back", "set": {"phase": "RESTORING"}, "expect": "PHASE"},
    {"name": "COMMITTED is not this path", "set": {"phase": "COMMITTED"}, "expect": "PHASE"},
    {"name": "not a pair transition", "unset": ["pair_transition"], "expect": "NOT-PAIR"},
    {"name": "external-lan proof", "set": {"proof_scope": "external-lan"}, "expect": "NOT-PAIR"},
    {"name": "trial", "set": {"trial": true}, "expect": "NOT-AUTOMATIC"},
    {"name": "manual switch", "set": {"manual_request_id": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd", "transition_source": "manual"}, "expect": "NOT-AUTOMATIC"},
    {"name": "manual source label", "set": {"transition_source": "manual"}, "expect": "NOT-AUTOMATIC"},
    {"name": "a manual request id alone", "set": {"manual_request_id": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"}, "expect": "NOT-AUTOMATIC"},
    {"name": "policy reapply", "set": {"activation_reapply": true}, "expect": "NOT-AUTOMATIC"},
    {"name": "return to the primary", "set": {"pair_transition": {"destination_role": "source", "before_policy_role": "target"}}, "expect": "NOT-FORWARD"},
    {"name": "leaving the reserve", "set": {"pair_transition": {"destination_role": "target", "before_policy_role": "target"}}, "expect": "NOT-FORWARD"},
    {"name": "no order change", "set": {"after": ["r1", "r2"]}, "expect": "NOT-FORWARD"},
    {"name": "a restore step recorded", "set": {"restore_target_order": ["r1", "r2"]}, "expect": "ROLLBACK-STARTED"},
    {"name": "a failure recorded", "set": {"failure_code": "KERNEL-POLICY-UNVERIFIED"}, "expect": "ROLLBACK-STARTED"},
    {"name": "a rollback failure counted", "set": {"rollback_failures": 1}, "expect": "ROLLBACK-STARTED"},
    {"name": "already confirmed", "set": {"confirmed": 1010.0}, "expect": "ROLLBACK-STARTED"},
    {"name": "finished", "set": {"finished": 1010.0}, "expect": "ROLLBACK-STARTED"},
    {"name": "one resume per transaction", "set": {"forward_resumed": {"time": 1010.0, "from_phase": "APPLYING", "kernel": "reserve", "stage": "apply"}}, "expect": "ALREADY-RESUMED"},
    {"name": "power cut: no RAM file of this transaction", "facts": {"same_boot": false}, "expect": "OTHER-BOOT"},
    {"name": "power cut: the monotonic clock restarted", "facts": {"mono": 30.0}, "expect": "OTHER-BOOT"},
    {"name": "legacy journal without a monotonic deadline", "set": {"monotonic_deadline": null}, "expect": "OTHER-BOOT"},
    {"name": "wall deadline too close", "facts": {"wall": 1106.0}, "expect": "EXPIRED"},
    {"name": "monotonic deadline too close", "facts": {"mono": 606.0}, "expect": "EXPIRED"},
    {"name": "owner Auto not wanted (Stop newer than the marker, no marker)", "facts": {"wanted": false}, "expect": "OWNER-STOP"},
    {"name": "service stopping", "facts": {"stopping": true}, "expect": "OWNER-STOP"},
    {"name": "Stop during this switch", "facts": {"stop_requested": 1001.0}, "expect": "OWNER-STOP"},
    {"name": "unreadable Stop latch", "facts": {"stop_requested": "UNREADABLE"}, "expect": "OWNER-STOP"},
    {"name": "the primary is back", "facts": {"source_health": true}, "expect": "SOURCE-NOT-FAILED"},
    {"name": "the primary unknown", "facts": {"source_health": null}, "expect": "SOURCE-NOT-FAILED"},
    {"name": "the reserve failing", "facts": {"reserve_health": false}, "expect": "RESERVE-NOT-HEALTHY"},
    {"name": "the reserve unknown", "facts": {"reserve_health": null}, "expect": "RESERVE-NOT-HEALTHY"},
    {"name": "an owner Stop wins over the health checks", "facts": {"wanted": false, "source_health": true, "reserve_health": false}, "expect": "OWNER-STOP"}
  ]
}
